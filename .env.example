# Optional. The core app and local phrase recognition work without these.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional Atlas event mirror. Install requirements-optional.txt first.
MONGODB_URI=
MONGODB_DATABASE=unmute
# Required if serving on a network interface instead of localhost.
UNMUTE_TOKEN=
# Optional pretrained visual speech model, in a separate compatible environment.
AVSR_PYTHON=
AVSR_REPO=
AVSR_CONFIG=
AVSR_TIMEOUT=120
